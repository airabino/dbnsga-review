@techreport{CARB_2018_CARB,
  author = {{California Air Resources Board}},
  title = {Innovative Clean Transit (ICT) Regulation},
  institution = {California Air Resources Board},
  year = {2018},
  address = {Sacramento, CA},
  url = {https://ww2.arb.ca.gov/our-work/programs/innovative-clean-transit/about},
  note = {The ICT regulation, adopted in December 2018, mandates that all California public transit agencies transition to 100\% zero-emission bus fleets by 2040. ZEB purchase requirements begin in 2023 for large agencies and 2026 for smaller ones, escalating to 100\% of new purchases by 2029. The regulation requires each agency to submit a ZEB Rollout Plan detailing procurement, infrastructure, and workforce training timelines.}
}

@techreport{Jeffers_2022_OSTI,
  author = {Jeffers, M. and Kelly, K. and Lipman, T. and Fernandes Tomon Avelino, A. and Johnson, C. and Li, M. and Post, M. and Zhang, Y.},
  title = {Comprehensive Review of California's Innovative Clean Transit Regulation: Phase I Summary Report},
  institution = {National Renewable Energy Laboratory},
  year = {2022},
  number = {NREL/TP-5400-81928},
  url = {https://www.osti.gov/servlets/purl/1892294},
  note = {Prepared by NREL and UC Berkeley for CARB, this Phase I review examines implementation progress, technology readiness, and California transit agencies' preparedness to meet the 2023 ICT purchase requirements. The report documents the state of BEB and FCEB deployments, infrastructure development status, and remaining barriers to compliance across California transit agencies.}
}

@techreport{FTA_2022_FTA,
  author = {{Federal Transit Administration}},
  title = {Zero Emission Fleet Transition Plan Requirements Under the Bipartisan Infrastructure Law},
  institution = {U.S. Department of Transportation},
  year = {2022},
  address = {Washington, DC},
  url = {https://www.transit.dot.gov/funding/grants/zero-emission-fleet-transition-plan},
  note = {Under the Bipartisan Infrastructure Law, transit agencies using the Low or No Emission Program must submit Zero Emission Fleet Transition Plans covering six required elements, including workforce skill gaps, training needs, and avoidance of worker displacement. The FTA guidance outlines steps for developing these plans in partnership with labor organizations.}
}

@article{Pelletier_2019_TRC,
  author = {Pelletier, S. and Jabali, O. and Laporte, G. and Veneroni, M.},
  title = {The Electric Bus Fleet Transition Problem},
  journal = {Transportation Research Part C: Emerging Technologies},
  volume = {109},
  pages = {174--193},
  year = {2019},
  doi = {10.1016/j.trc.2019.10.012},
  note = {This study introduces the Electric Bus Fleet Transition Problem (EBFTP) as an integer linear program that simultaneously models vehicle purchasing decisions, salvage decisions, charging infrastructure investments, and electrification targets over a multi-year horizon. Multiple charging configurations are considered, with computational experiments applied to real transit data from a Canadian agency.}
}

@article{Zhou_2023_AE,
  author = {Zhou, Y. and Ong, G. P. and Meng, Q.},
  title = {The Road to Electrification: Bus Fleet Replacement Strategies},
  journal = {Applied Energy},
  volume = {337},
  pages = {120903},
  year = {2023},
  doi = {10.1016/j.apenergy.2023.120903},
  note = {This study examines optimal fleet replacement strategies for transitioning from diesel to electric buses using a multi-period optimization framework. It considers the interaction between vehicle purchase timing, battery degradation, and electricity pricing, providing cost-benefit analyses across different scenarios of government subsidy and technology cost trajectory assumptions.}
}

@article{Wagner_2024_AE,
  author = {Wagner, D. and Walther, G.},
  title = {Techno-economic analysis of mixed battery and fuel cell electric bus fleets: A case study},
  journal = {Applied Energy},
  volume = {376},
  pages = {124285},
  year = {2024},
  doi = {10.1016/j.apenergy.2024.124285},
  note = {This paper extends planning models to accommodate mixed BEB and FCEB fleets with respective charging and fueling infrastructure. Applied to a real-world case study, results show that heterogeneous BEB fleets with mixed charging offer lower total costs than homogeneous FCEB fleets. FCEBs become cost-competitive when purchase costs fall below approximately 625,000 euros or hydrogen costs drop below approximately 4.33 euros/kg.}
}

@article{Rogge_2018_AE,
  author = {Rogge, M. and van der Hurk, E. and Larsen, A. and Sauer, D. U.},
  title = {Electric Bus Fleet Size and Mix Problem with Optimization of Charging Infrastructure},
  journal = {Applied Energy},
  volume = {211},
  pages = {282--295},
  year = {2018},
  doi = {10.1016/j.apenergy.2017.11.051},
  note = {This study formulates the Electric Bus Fleet Size and Mix Problem integrating fleet composition and charging infrastructure optimization within a unified mathematical framework. Battery capacity sizing decisions, charger placements, and fleet-level operational feasibility are all treated as decision variables, applied to a case study of urban transit in Germany.}
}

@misc{Karmimi_2024_OO,
  author = {Karimi, N. and Kocuk, B. and Y\"{u}ksel, T.},
  title = {A Dynamic Strategic Plan for the Transition to a Clean Bus Fleet Using Multi-Stage Stochastic Programming: A Case Study in Istanbul},
  howpublished = {Optimization Online},
  year = {2024},
  url = {https://optimization-online.org/wp-content/uploads/2024/10/A-Dynamic-Strategic-Plan-for-the-Transition-to-a-Clean-Bus-Fleet-using-Multi-Stage-Stochastic-Programming-with-a-Case-Study-in-Istanbul.pdf},
  note = {This paper develops a multi-stage stochastic program for dynamic bus fleet transition planning under uncertainty, applied to a large fleet in Istanbul. The model includes diesel, BEB (overnight and fast charging), and hydrogen fuel cell bus options, with stochastic treatment of technology cost trajectories across scenario trees representing yearly purchasing, salvaging, and route assignment decisions.}
}

@article{Friess_2024_PT,
  author = {Frie\ss, N. M. and Pferschy, U.},
  title = {Planning a zero-emission mixed-fleet public bus system with minimal life cycle cost},
  journal = {Public Transport},
  volume = {16},
  pages = {39--79},
  year = {2024},
  doi = {10.1007/s12469-023-00345-4},
  note = {This paper proposes an ILP-based model to determine optimal technology choices for each bus line in a zero-emission mixed fleet, covering overnight charging, opportunity charging, and hydrogen-based options. Applied to the Graz, Austria bus network, the model minimizes life cycle costs through technology-specific network representations for five distinct drive technologies.}
}

@techreport{EUDY_2021_OSTI,
  author = {Eudy, L. and Jeffers, M.},
  title = {Foothill Transit Battery Electric Bus Evaluation: Final Report},
  institution = {National Renewable Energy Laboratory},
  year = {2021},
  number = {NREL/TP-5400-80022},
  url = {https://docs.nrel.gov/docs/fy21osti/80022.pdf},
  note = {NREL's multi-year evaluation of Proterra fast-charge BEBs at Foothill Transit (Southern California) documents fuel costs of \$0.45/mile versus \$0.28/mile for CNG baseline, maintenance costs of \$0.50-0.56/mile versus \$0.32/mile for CNG, and reliability at 5,680-8,053 miles between roadcalls versus 25,000+ for CNG. Operational data covers July 2016 through December 2020.}
}

@techreport{Post_2022_OSTI,
  author = {Post, M. and Collins, E.},
  title = {SunLine Transit Agency Fuel Cell Electric Bus Progress Report: Data Period Focus January 2020 through December 2021},
  institution = {National Renewable Energy Laboratory},
  year = {2022},
  number = {NREL/TP-5400-83559},
  url = {https://docs.nlr.gov/docs/fy22osti/83559.pdf},
  note = {This NREL evaluation of SunLine Transit Agency's FCEB fleet in the Coachella Valley documents hydrogen fuel costs ranging from \$7.88 to \$21.04/kg (average \$13.79/kg), performance metrics including fuel economy and reliability, and maintenance cost per mile. Five CNG buses serve as a baseline comparison for the 2019 model year FCEBs evaluated.}
}

@techreport{Post_2023_OSTI,
  author = {Post, M.},
  title = {Hydrogen Fuel Cell Electric Bus (FCEB) Evaluations in US Public Transit Service},
  institution = {National Renewable Energy Laboratory},
  year = {2023},
  number = {NREL/PR-5400-84766},
  url = {https://www.osti.gov/biblio/1971855},
  note = {Synthesizing 19 years of NREL FCEB evaluations, this presentation reports that current-generation FCEBs achieve fuel economy 35\% better than previous generations and double that of conventional buses. With one bus exceeding 35,000 service hours, maintenance costs for FCEBs are shown to be equivalent to diesel and BEBs -- a significant finding for mixed-fleet cost modeling.}
}

@article{Chen_2024_s,
  author = {Chen, Z. and Wang, H.},
  title = {Total Cost of Ownership Analysis of Fuel Cell Electric Bus with Different Hydrogen Supply Alternatives},
  journal = {Sustainability},
  volume = {16},
  number = {1},
  pages = {259},
  year = {2024},
  doi = {10.3390/su16010259},
  note = {This study performs comprehensive TCO and sensitivity analyses for FCEB fleets under five hydrogen supply scenarios including on-site electrolysis, steam methane reforming, and off-site procurement, for both a 5-bus and 100-bus fleet. For a 100-bus fleet projected to 2028, a breakeven point versus diesel emerges for all hydrogen alternatives, with projected levelized electrolytic hydrogen costs of approximately \$4.33/kg.}
}

@article{Sistig_2025_SMT,
  author = {Sistig, H. M. and Sinhuber, P. and Rogge, M. and Sauer, D. U.},
  title = {Evaluating Costs and Operations of Public Bus Fleet Electrification},
  journal = {npj Sustainable Mobility and Transport},
  year = {2025},
  doi = {10.1038/s44333-025-00030-y},
  note = {This study evaluates full BEB electrification across 20 representative German transit networks, finding an average 12\% cost increase and 13\% more vehicles required compared to diesel fleets. High charging power is found to provide greater operational benefits than increasing battery capacity. The authors conclude electrification is technically and economically feasible with appropriate scheduling adjustments.}
}

